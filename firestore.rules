rules_version = '2';

// ===============================================================
// Assumed Data Model — Melow Tic Tac Toe v3.8.0
// ===============================================================
//
// Collection: rooms/{roomId}
// Document ID: 6-character unguessable room code
// Fields:
//   - hostId: string (required, 1..128, immutable, == auth.uid on create)
//   - guestId: string (required, '' on create, == auth.uid on join, immutable after join)
//   - hostName: string (required, 1..20, immutable)
//   - guestName: string (optional on create, 1..20 on join, immutable after join)
//   - hostEmoji: string (required, 1..16; mutable only on round-1 wheel lock-in)
//   - guestEmoji: string (optional on create, 1..16 on join, != hostEmoji; mutable only on round-1 wheel lock-in)
//   - hostAvatar: string (optional, nullable, 0..32, immutable)
//   - guestAvatar: string (optional, nullable, 0..32, set on join, immutable after join)
//   - gameMode: string (optional, 'classic' | 'blitz'; mutable only on round-1 wheel lock-in)
//   - size: int (required, 3 | 4 | 5 | 6; mutable only on round-1 wheel lock-in)
//   - bestOf: int (required, 3 | 5; mutable only on round-1 wheel lock-in)
//   - status: string (required, 'lobby' | 'playing' | 'finished' | 'abandoned')
//   - board: list (required, length == size * size)
//   - turn: string (required, 'h' | 'g')
//   - round: int (required, 1..200)
//   - roundDone: bool (required)
//   - hostWins: int (required, 0..10)
//   - guestWins: int (required, 0..10)
//   - draws: int (required, 0..200)
//   - lastResult: string (optional, '' | 'h' | 'g' | 'draw')
//   - champion: string (optional, '' | 'h' | 'g')
//   - turnStartedAt: timestamp (optional, nullable)
//   - turnDeadlineAt: timestamp (optional, nullable)
//   - timeoutWinner: string (optional, nullable, '' | 'h' | 'g')
//   - wheelProposal: map (<=16 keys) | string (<=100) (optional, nullable)
//   - wheelResult: map (<=16 keys) | string (<=100) (optional, nullable)
//   - hostLeft: bool (optional, nullable; only host may change)
//   - guestLeft: bool (optional, nullable; only guest may change)
//   - createdAt: timestamp (required, == request.time on create, immutable)
//   - updatedAt: timestamp (optional, nullable)
//   - expiresAt: timestamp (optional, nullable, immutable)
//
// Subcollection: rooms/{roomId}/messages/{messageId}
// Fields:
//   - uid: string (required, == auth.uid)
//   - text: string (optional, nullable, 0..280; required non-empty if imageBase64 absent/empty)
//   - imageBase64: string (optional, nullable, 0..320000; required non-empty if text absent/empty)
//   - createdAt: timestamp (required, == request.time)
//   - expireAt: timestamp (required, > request.time && < request.time + 25h)
//
// Subcollection: rooms/{roomId}/reactions/{reactionId}
// Fields:
//   - senderUid: string (required, == auth.uid)
//   - kind: string (required, 'emoji' | 'taunt')
//   - payload: string (required, 1..40)
//   - createdAt: timestamp (required, == request.time)
//   - expireAt: timestamp (required, > request.time && < request.time + 10m)
//
// Collection: users/{uid} (Non-PII public/game profile ONLY; no email/phone/private prefs)
// Fields:
//   - nickname: string (required, 1..20)
//   - avatarId: string (required, 1..32)
//   - photoBase64: string (optional, nullable, 0..140000 — compressed 256px gallery avatar)
//   - preferredEmoji: string (required, 1..16)
//   - friendCode: string (optional, 6..12, immutable once set)
//   - publicProfileEnabled: bool (required)
//   - leaderboardOptIn: bool (required)
//   - profileVisibility: string (optional, nullable, 'public' | 'friends' | 'private')
//   - hidePhotoGlobally: bool (optional, nullable)
//   - hideNameGlobally: bool (optional, nullable)
//   - allowGlobalFriendRequests: bool (optional, nullable)
//   - registeredUsername: string (optional, nullable, 0..20)
//   - createdAt: timestamp (optional, == request.time on create, immutable once set)
//   - updatedAt: timestamp (optional)
//
// Subcollection: users/{uid}/private/{docId} (Owner-only private preferences/settings)
//   - Bounded map (<=30 keys), optional createdAt (immutable)/updatedAt timestamps,
//     optional hiddenRivalUids list (<=500 items).
//
// Subcollection: users/{uid}/friends/{friendUid}
// Fields:
//   - friendUid: string (required, == friendUid, != uid, immutable)
//   - nickname: string (required, 1..20)
//   - avatarId: string (required, 1..32)
//   - photoBase64: string (optional, nullable, 0..140000)
//   - since: timestamp (required, immutable)
//   - status: string (required, 'accepted' | 'pending'; must be 'accepted' when written by friendUid)
//
// Subcollection: users/{uid}/blocked/{blockedUid}
// Fields:
//   - blockedUid: string (optional, == blockedUid)
//   - uid: string (optional, == blockedUid)
//   - nickname: string (optional, nullable, 0..20)
//   - avatarId: string (optional, nullable, 0..32)
//   - reason: string (optional, nullable, 0..300)
//   - createdAt: timestamp (optional, immutable once set)
//
// Subcollection: users/{uid}/processedMatches/{matchId} (Immutable idempotency ledger)
// Fields:
//   - roomId: string (required, 6 chars)
//   - processedAt: timestamp (required, == request.time)
//   - matchId: string (optional, == matchId)
//
// Subcollection: users/{uid}/achievements/{achievementId}
// Fields:
//   - achievementId: string (required, == achievementId, immutable)
//   - progress: int (required, 0..100)
//   - verified: bool (required)
//   - unlockedAt: timestamp (optional, nullable)
//
// Subcollection: users/{uid}/trophies/{trophyId} (Immutable, verified against finished room champion)
// Fields:
//   - trophyId: string (required, == trophyId)
//   - matchId: string (required, 1..128)
//   - roomId: string (required, 6 chars, references finished room where uid is champion)
//   - title: string (required, 1..80)
//   - awardedAt: timestamp (required, == request.time)
//
// Collection: friendCodes/{code}
// Document ID: 6..12 character friend code
// Fields:
//   - uid: string (required, == auth.uid)
//   - createdAt: timestamp (required, == request.time)
//
// Collection: friendRequests/{requestId}
// Fields:
//   - senderUid: string (required, == auth.uid on create, immutable)
//   - senderName: string (required, 1..20, immutable)
//   - senderAvatar: string (optional, nullable, 0..32, immutable)
//   - receiverUid: string (required, != senderUid, immutable)
//   - receiverName: string (optional, nullable, 0..20)
//   - receiverAvatar: string (optional, nullable, 0..32)
//   - status: string (required, 'pending' on create -> 'accepted'|'declined'|'cancelled')
//   - createdAt: timestamp (required, == request.time on create, immutable)
//   - expiresAt: timestamp (optional, nullable, immutable)
//
// Collection: friendChallenges/{challengeId}
// Fields:
//   - senderUid: string (required, == auth.uid on create, immutable; sender may delete)
//   - senderName: string (required, 1..20, immutable)
//   - senderAvatar: string (optional, nullable, 0..32, immutable)
//   - senderEmoji: string (optional, nullable, 0..16, immutable)
//   - receiverUid: string (required, != senderUid, immutable)
//   - receiverName: string (optional, nullable, 0..20, immutable)
//   - mode: string (required, 'classic' | 'blitz', immutable)
//   - boardSize: int (required, 3 | 4 | 5 | 6, immutable)
//   - bestOf: int (required, 3 | 5, immutable)
//   - roomId: string (optional, nullable, 0..6; required 6 chars on accept)
//   - status: string (required, 'pending' -> 'accepted'|'declined'|'cancelled'; 'accepted' -> 'cancelled' by sender)
//   - createdAt: timestamp (required, == request.time on create, immutable)
//   - expiresAt: timestamp (optional, nullable, immutable)
//
// Collection: reports/{reportId}
// Fields:
//   - reporterUid: string (required, == auth.uid)
//   - reportedUid: string (required, 1..128, != auth.uid)
//   - reason: string (required, 1..300)
//   - createdAt: timestamp (required, == request.time)
//
// Collection: stats/{uid} (Owner-writable with bounded post-match deltas, Spark-compatible)
// Fields:
//   - gamesPlayed, wins, losses, draws, currentStreak, bestStreak, blitzWins, megaWins: int (0..1000000; +0..5 per update)
//   - tournamentsWon, trophyCount: int (0..1000000; +0..1 per update)
//   - updatedAt: timestamp (optional, nullable)
//
// Collection: matches/{matchId} (Immutable, verified against finished room membership)
// Fields:
//   - roomId: string (required, 6 chars)
//   - players: list<string> (required, size == 2, matches room hostId & guestId)
//   - playerNames: map (optional, nullable, size <= 4)
//   - gameMode: string (required, 'classic' | 'blitz')
//   - boardSize: int (required, 3 | 4 | 5 | 6)
//   - hostWins: int (required, 0..10)
//   - guestWins: int (required, 0..10)
//   - draws: int (required, 0..200)
//   - finalWinnerUid: string (required, 0..128)
//   - finalStatus: string (required, 'won' | 'draw')
//   - completedAt: timestamp (required)
//   - processedAt: timestamp (optional, nullable)
//
// Collection: rivalries/{rivalryId} (Participant-writable with immutable playerUids & bounded deltas)
// Fields:
//   - playerUids: list<string> (required, size == 2, immutable)
//   - winsByPlayer: map (optional, size <= 2, keys subset of playerUids)
//   - draws, totalMatches, currentStreak, bestStreak: int (0..1000000; totalMatches +0..1 on update)
//   - currentStreakOwner: string (optional, nullable, 0..128)
//   - lastMatchAt: timestamp (optional, nullable)
//
// Collection: leaderboardEntries/{uid} (Owner-writable with bounded deltas or stats-bounded resync)
// Fields:
//   - publicNickname: string (required, 1..20)
//   - avatarId: string (required, 1..32)
//   - photoBase64: string (optional, nullable, 0..140000)
//   - wins, tournamentsWon, bestStreak, blitzWins: int (0..1000000; +0..1 on update or bounded by stats/{uid})
//   - optIn: bool (required)
//   - allowFriendRequests: bool (optional, nullable)
//   - updatedAt: timestamp (optional, nullable)
//
// Collection: chats/{chatId} (Direct 1-on-1 friend chat)
// Fields:
//   - participants: list<string> (required, size == 2, immutable)
//   - lastMessage: string (optional, nullable, 0..500)
//   - lastSenderUid: string (optional, nullable, 0..128)
//   - lastSenderName: string (optional, nullable, 0..20)
//   - lastMessageAt: timestamp (optional, nullable)
//   - unreadBy: list (<=2 UIDs) | map (<=2 keys) | string (0..128) (optional, nullable)
//   - unreadCounts: map<uid, int> (optional, nullable, <=2 keys subset of participants, 0..1000000)
//   - clearedAtBy: map<uid, timestamp> (optional, nullable, <=2 keys)
//   - updatedAt: timestamp (optional, nullable)
//
// Subcollection: chats/{chatId}/messages/{messageId}
// Fields:
//   - senderUid: string (required, == auth.uid on create, immutable)
//   - senderName: string (optional, nullable, 0..20)
//   - text: string (optional, nullable, 0..500; required non-empty if imageBase64 absent/empty)
//   - imageBase64: string (optional, nullable, 0..320000; required non-empty if text absent/empty)
//   - msgType: string (optional, nullable, 'text' | 'image' | 'call')
//   - deletedFor: list<string> (optional, nullable, <=2 UIDs; only field mutable on update by participants)
//   - createdAt: timestamp (required, == request.time on create, immutable)
//
// Collection: calls/{callId} (WebRTC P2P voice call signaling)
// Fields:
//   - callerUid: string (required, == auth.uid on create, immutable)
//   - calleeUid: string (required, != callerUid, immutable)
//   - callerName: string (required, 1..20)
//   - callerAvatar: string (optional, nullable, 0..32)
//   - calleeName: string (optional, nullable, 0..20)
//   - roomId: string (optional, nullable, 0..6)
//   - status: string (required, 'ringing' on create -> 'active'|'ended'|'declined'|'missed')
//   - offer: map (optional, nullable, keys subset of ['type', 'sdp'])
//   - answer: map (optional, nullable, keys subset of ['type', 'sdp'])
//   - createdAt: timestamp (required, == request.time on create, immutable)
//   - updatedAt: timestamp (optional, nullable)
//
// Subcollections: calls/{callId}/offerCandidates/{candidateId}
//                 calls/{callId}/answerCandidates/{candidateId}
// Fields:
//   - candidate: string (required, 0..2048)
//   - sdpMid: string (optional, nullable, 0..64)
//   - sdpMLineIndex: int (optional, nullable, 0..64)
//   - createdAt: timestamp (optional, nullable)
//
// Subcollection: calls/{callId}/audioChunks/{chunkId} (Relay Voice Mode fallback)
// Fields:
//   - senderUid: string (required, == auth.uid)
//   - audioBase64: string (required, 1..350000)
//   - durationMs: int (required, 0..60000)
//   - createdAt: timestamp (required, == request.time)
//
// Collection: config/{docId} (Read-only runtime app config; only docId == 'rtc' readable)
//   - Admin-managed dynamic TURN iceServers config; client list/write denied.
//
// Collection: groups/{groupId} (Friend Groups & Mini-Tournaments, up to 5 members)
// Fields:
//   - name: string (required, 1..24)
//   - creatorUid: string (required, 1..128, == auth.uid on create, immutable)
//   - hostFriendCode: string (optional, nullable, 0..12)
//   - maxMembers: int (optional, nullable, 2..5)
//   - memberUids: list<string> (required, size 1..5 && <= maxMembers, each string 1..128)
//   - memberNames: map (required, size <= 5)
//   - memberAvatars: map (required, size <= 5)
//   - tournamentStatus: string (required, 'active' | 'final_ready' | 'completed')
//   - championUid: string (optional, nullable, 0..128)
//   - championName: string (optional, nullable, 0..20)
//   - cupName: string (optional, nullable, 0..80)
//   - activeMatch: map (optional, nullable, size <= 15)
//   - winsByUid: map (optional, nullable, size <= 5)
//   - lossesByUid: map (optional, nullable, size <= 5)
//   - drawsByUid: map (optional, nullable, size <= 5)
//   - cupsByUid: map (optional, nullable, size <= 5)
//   - lastMessage: string (optional, nullable, 0..500)
//   - lastSenderUid: string (optional, nullable, 0..128)
//   - lastSenderName: string (optional, nullable, 0..20)
//   - lastMessageAt: timestamp (optional, nullable)
//   - clearedAtBy: map (optional, nullable, size <= 5)
//   - createdAt: timestamp (optional, nullable)
//   - updatedAt: timestamp (optional, nullable)
//
// Subcollection: groups/{groupId}/messages/{messageId}
// Fields:
//   - senderUid: string (required, == auth.uid on create, immutable)
//   - senderName: string (optional, nullable, 0..20)
//   - text: string (optional, nullable, 0..500; required non-empty if imageBase64 absent/empty)
//   - imageBase64: string (optional, nullable, 0..320000; required non-empty if text absent/empty)
//   - msgType: string (optional, nullable, 'text' | 'image' | 'call')
//   - deletedFor: list<string> (optional, nullable, <=5 UIDs; only field mutable on update by group members)
//   - createdAt: timestamp (required, == request.time on create, immutable)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Core Auth & Utility Helper Functions
    // ===============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isStringLen(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isOptionalNullableString(data, field, minLen, maxLen) {
      return !(field in data) ||
        data[field] == null ||
        isStringLen(data[field], minLen, maxLen);
    }

    function isOptionalNullableTimestamp(data, field) {
      return !(field in data) ||
        data[field] == null ||
        data[field] is timestamp;
    }

    function isOptionalNullableBool(data, field) {
      return !(field in data) ||
        data[field] == null ||
        data[field] is bool;
    }

    function isNonNegInt(val, maxVal) {
      return val is int && val >= 0 && val <= maxVal;
    }

    function isOptionalNonNegInt(data, field, maxVal) {
      return !(field in data) || isNonNegInt(data[field], maxVal);
    }

    function isBoundedDelta(nextVal, prevVal, minDelta, maxDelta) {
      return nextVal >= prevVal + minDelta && nextVal <= prevVal + maxDelta;
    }

    function isValidUidPair(val) {
      return val is list &&
        val.size() == 2 &&
        isStringLen(val[0], 1, 128) &&
        isStringLen(val[1], 1, 128) &&
        val[0] != val[1];
    }

    function isValidUidListMax2(val) {
      return val is list && (
        val.size() == 0 ||
        (val.size() == 1 && isStringLen(val[0], 1, 128)) ||
        (val.size() == 2 && isStringLen(val[0], 1, 128) && isStringLen(val[1], 1, 128))
      );
    }

    function isValidUidListMax5(val) {
      return val is list &&
        val.size() <= 5 &&
        (val.size() < 1 || isStringLen(val[0], 1, 128)) &&
        (val.size() < 2 || isStringLen(val[1], 1, 128)) &&
        (val.size() < 3 || isStringLen(val[2], 1, 128)) &&
        (val.size() < 4 || isStringLen(val[3], 1, 128)) &&
        (val.size() < 5 || isStringLen(val[4], 1, 128));
    }

    function isValidGroupMemberUids(val) {
      return val is list &&
        val.size() >= 1 &&
        isValidUidListMax5(val);
    }

    function isOptionalNullableBoundedMap(data, field, maxSize) {
      return !(field in data) ||
        data[field] == null ||
        (data[field] is map && data[field].size() <= maxSize);
    }

    function isValidUnreadBy(d) {
      return !('unreadBy' in d) ||
        d.unreadBy == null ||
        isStringLen(d.unreadBy, 0, 128) ||
        isValidUidListMax2(d.unreadBy) ||
        (d.unreadBy is map && d.unreadBy.size() <= 2);
    }

    function isValidUnreadCounts(d) {
      return !('unreadCounts' in d) ||
        d.unreadCounts == null || (
          d.unreadCounts is map &&
          d.unreadCounts.size() <= 2 &&
          d.unreadCounts.keys().hasOnly(d.participants) &&
          (!(d.participants[0] in d.unreadCounts) || isNonNegInt(d.unreadCounts[d.participants[0]], 1000000)) &&
          (!(d.participants[1] in d.unreadCounts) || isNonNegInt(d.unreadCounts[d.participants[1]], 1000000))
        );
    }

    function isOptionalWheelPayload(data, field) {
      return !(field in data) ||
        data[field] == null ||
        (data[field] is map && data[field].size() <= 16) ||
        (data[field] is string && data[field].size() <= 100);
    }

    function isOptionalNullableSdpMap(data, field) {
      return !(field in data) ||
        data[field] == null || (
          data[field] is map &&
          data[field].keys().hasOnly(['type', 'sdp']) &&
          isOptionalNullableString(data[field], 'type', 1, 32) &&
          isOptionalNullableString(data[field], 'sdp', 0, 32768)
        );
    }

    function isRoomMember(d) {
      return signedIn() && (d.hostId == request.auth.uid || d.guestId == request.auth.uid);
    }

    function roomExistsAndMember(roomId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/rooms/$(roomId)) &&
        isRoomMember(get(/databases/$(database)/documents/rooms/$(roomId)).data);
    }

    function isRoomChampionData(roomData, uid) {
      return roomData.status == 'finished' && (
        (roomData.hostId == uid && roomData.champion == 'h') ||
        (roomData.guestId == uid && roomData.champion == 'g')
      );
    }

    function isFinishedRoomChampion(roomId, uid) {
      return isStringLen(roomId, 6, 6) &&
        exists(/databases/$(database)/documents/rooms/$(roomId)) &&
        isRoomChampionData(get(/databases/$(database)/documents/rooms/$(roomId)).data, uid);
    }

    function isFinishedRoomDataForMatch(roomData, matchData) {
      return roomData.status == 'finished' &&
        isRoomMember(roomData) &&
        roomData.hostId in matchData.players &&
        roomData.guestId in matchData.players;
    }

    function isFinishedRoomMemberMatch(d) {
      return isStringLen(d.roomId, 6, 6) &&
        exists(/databases/$(database)/documents/rooms/$(d.roomId)) &&
        isFinishedRoomDataForMatch(get(/databases/$(database)/documents/rooms/$(d.roomId)).data, d);
    }

    function isPublicProfile(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
        get(/databases/$(database)/documents/users/$(uid)).data.publicProfileEnabled == true;
    }

    function isBlockedBy(targetUid, actorUid) {
      return exists(/databases/$(database)/documents/users/$(targetUid)/blocked/$(actorUid));
    }

    function otherParticipant(participants) {
      return participants[0] == request.auth.uid ? participants[1] : participants[0];
    }

    function chatExistsAndParticipant(chatId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/chats/$(chatId)) &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function groupExistsAndMember(groupId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)) &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
    }

    function callExistsAndParticipant(callId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/calls/$(callId)) && (
          get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid ||
          get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid
        );
    }

    function isLeaderboardBoundedByStats(d, s) {
      return d.get('wins', 0) <= s.get('wins', 0) + 1 &&
        d.get('tournamentsWon', 0) <= s.get('tournamentsWon', 0) + 1 &&
        d.get('bestStreak', 0) <= s.get('bestStreak', 0) + 1 &&
        d.get('blitzWins', 0) <= s.get('blitzWins', 0) + 1;
    }

    function isValidLeaderboardCreateCounts(uid, d) {
      return (
        d.get('wins', 0) <= 1 &&
        d.get('tournamentsWon', 0) <= 1 &&
        d.get('bestStreak', 0) <= 1 &&
        d.get('blitzWins', 0) <= 1
      ) || (
        exists(/databases/$(database)/documents/stats/$(uid)) &&
        isLeaderboardBoundedByStats(d, get(/databases/$(database)/documents/stats/$(uid)).data)
      );
    }

    // ===============================================================
    // Domain Validators (Called in BOTH create and update rules)
    // ===============================================================

    function isValidRoom(d) {
      return d.keys().hasOnly([
          'hostId', 'guestId', 'hostName', 'guestName', 'hostEmoji', 'guestEmoji',
          'hostAvatar', 'guestAvatar', 'gameMode', 'size', 'bestOf', 'status',
          'board', 'turn', 'round', 'roundDone', 'hostWins', 'guestWins', 'draws',
          'lastResult', 'champion', 'turnStartedAt', 'turnDeadlineAt', 'timeoutWinner',
          'wheelProposal', 'wheelResult', 'hostLeft', 'guestLeft',
          'createdAt', 'updatedAt', 'expiresAt'
        ]) &&
        d.keys().hasAll([
          'hostId', 'guestId', 'hostName', 'hostEmoji', 'size', 'bestOf',
          'status', 'board', 'turn', 'round', 'roundDone',
          'hostWins', 'guestWins', 'draws', 'createdAt'
        ]) &&
        isStringLen(d.hostId, 1, 128) &&
        isStringLen(d.guestId, 0, 128) &&
        isStringLen(d.hostName, 1, 20) &&
        isOptionalNullableString(d, 'guestName', 0, 20) &&
        isStringLen(d.hostEmoji, 1, 16) &&
        isOptionalNullableString(d, 'guestEmoji', 0, 16) &&
        isOptionalNullableString(d, 'hostAvatar', 0, 32) &&
        isOptionalNullableString(d, 'guestAvatar', 0, 32) &&
        (!('gameMode' in d) || d.gameMode == null || d.gameMode in ['classic', 'blitz']) &&
        d.size is int && d.size in [3, 4, 5, 6] &&
        d.bestOf is int && d.bestOf in [3, 5] &&
        d.status in ['lobby', 'playing', 'finished', 'abandoned'] &&
        d.board is list && d.board.size() == d.size * d.size &&
        d.turn in ['h', 'g'] &&
        d.round is int && d.round >= 1 && d.round <= 200 &&
        d.roundDone is bool &&
        d.hostWins is int && d.hostWins >= 0 && d.hostWins <= 10 &&
        d.guestWins is int && d.guestWins >= 0 && d.guestWins <= 10 &&
        d.draws is int && d.draws >= 0 && d.draws <= 200 &&
        (!('lastResult' in d) || d.lastResult in ['', 'h', 'g', 'draw']) &&
        (!('champion' in d) || d.champion in ['', 'h', 'g']) &&
        isOptionalNullableTimestamp(d, 'turnStartedAt') &&
        isOptionalNullableTimestamp(d, 'turnDeadlineAt') &&
        (!('timeoutWinner' in d) || d.timeoutWinner == null || d.timeoutWinner in ['', 'h', 'g']) &&
        isOptionalWheelPayload(d, 'wheelProposal') &&
        isOptionalWheelPayload(d, 'wheelResult') &&
        isOptionalNullableBool(d, 'hostLeft') &&
        isOptionalNullableBool(d, 'guestLeft') &&
        d.createdAt is timestamp &&
        isOptionalNullableTimestamp(d, 'updatedAt') &&
        isOptionalNullableTimestamp(d, 'expiresAt');
    }

    function canModifyWheelConfig(prev, next) {
      let configKeys = ['gameMode', 'size', 'bestOf', 'hostEmoji', 'guestEmoji'];
      return !next.diff(prev).affectedKeys().hasAny(configKeys) || (
        ('wheelResult' in next) &&
        next.wheelResult != null &&
        prev.round == 1 &&
        next.round == 1 &&
        prev.hostWins == 0 &&
        prev.guestWins == 0 &&
        prev.draws == 0 &&
        next.hostWins == 0 &&
        next.guestWins == 0 &&
        next.draws == 0 &&
        next.hostEmoji != next.guestEmoji
      );
    }

    function isValidChatMessage(d) {
      return d.keys().hasOnly(['uid', 'text', 'imageBase64', 'createdAt', 'expireAt']) &&
        d.keys().hasAll(['uid', 'createdAt', 'expireAt']) &&
        d.uid == request.auth.uid &&
        isOptionalNullableString(d, 'text', 0, 280) &&
        isOptionalNullableString(d, 'imageBase64', 0, 320000) &&
        (
          ('text' in d && d.text is string && d.text.size() > 0) ||
          ('imageBase64' in d && d.imageBase64 is string && d.imageBase64.size() > 0)
        ) &&
        d.createdAt == request.time &&
        d.expireAt is timestamp &&
        d.expireAt > request.time &&
        d.expireAt < request.time + duration.value(25, 'h');
    }

    function isValidReaction(d) {
      return d.keys().hasOnly(['senderUid', 'kind', 'payload', 'createdAt', 'expireAt']) &&
        d.keys().hasAll(['senderUid', 'kind', 'payload', 'createdAt', 'expireAt']) &&
        d.senderUid == request.auth.uid &&
        d.kind in ['emoji', 'taunt'] &&
        isStringLen(d.payload, 1, 40) &&
        d.createdAt == request.time &&
        d.expireAt is timestamp &&
        d.expireAt > request.time &&
        d.expireAt < request.time + duration.value(10, 'm');
    }

    function isValidUserProfile(d) {
      return d.keys().hasOnly([
          'nickname', 'avatarId', 'photoBase64', 'preferredEmoji', 'friendCode',
          'publicProfileEnabled', 'leaderboardOptIn',
          'profileVisibility', 'hidePhotoGlobally', 'hideNameGlobally',
          'allowGlobalFriendRequests', 'registeredUsername', 'createdAt', 'updatedAt'
        ]) &&
        d.keys().hasAll([
          'nickname', 'avatarId', 'preferredEmoji',
          'publicProfileEnabled', 'leaderboardOptIn'
        ]) &&
        isStringLen(d.nickname, 1, 20) &&
        isStringLen(d.avatarId, 1, 32) &&
        isOptionalNullableString(d, 'photoBase64', 0, 140000) &&
        isStringLen(d.preferredEmoji, 1, 16) &&
        (!('friendCode' in d) || d.friendCode == null || isStringLen(d.friendCode, 6, 12)) &&
        d.publicProfileEnabled is bool &&
        d.leaderboardOptIn is bool &&
        (!('profileVisibility' in d) || d.profileVisibility == null || d.profileVisibility in ['public', 'friends', 'private']) &&
        isOptionalNullableBool(d, 'hidePhotoGlobally') &&
        isOptionalNullableBool(d, 'hideNameGlobally') &&
        isOptionalNullableBool(d, 'allowGlobalFriendRequests') &&
        isOptionalNullableString(d, 'registeredUsername', 0, 20) &&
        isOptionalNullableTimestamp(d, 'createdAt') &&
        isOptionalNullableTimestamp(d, 'updatedAt');
    }

    function isValidPrivateDoc(d, docId) {
      return isStringLen(docId, 1, 64) &&
        d.keys().size() <= 30 &&
        isOptionalNullableTimestamp(d, 'createdAt') &&
        isOptionalNullableTimestamp(d, 'updatedAt') &&
        (!('hiddenRivalUids' in d) || (d.hiddenRivalUids is list && d.hiddenRivalUids.size() <= 500));
    }

    function isValidFriendEntry(d, ownerUid, friendUid) {
      return d.keys().hasOnly(['friendUid', 'nickname', 'avatarId', 'photoBase64', 'since', 'status']) &&
        d.keys().hasAll(['friendUid', 'nickname', 'avatarId', 'since', 'status']) &&
        d.friendUid == friendUid &&
        friendUid != ownerUid &&
        isStringLen(d.friendUid, 1, 128) &&
        isStringLen(d.nickname, 1, 20) &&
        isStringLen(d.avatarId, 1, 32) &&
        isOptionalNullableString(d, 'photoBase64', 0, 140000) &&
        d.since is timestamp &&
        d.status in ['accepted', 'pending'];
    }

    function isValidBlockedEntry(d, ownerUid, blockedUid) {
      return blockedUid != ownerUid &&
        isStringLen(blockedUid, 1, 128) &&
        d.keys().hasOnly(['blockedUid', 'uid', 'nickname', 'avatarId', 'reason', 'createdAt']) &&
        (!('blockedUid' in d) || d.blockedUid == blockedUid) &&
        (!('uid' in d) || d.uid == blockedUid) &&
        isOptionalNullableString(d, 'nickname', 0, 20) &&
        isOptionalNullableString(d, 'avatarId', 0, 32) &&
        isOptionalNullableString(d, 'reason', 0, 300) &&
        isOptionalNullableTimestamp(d, 'createdAt');
    }

    function isValidProcessedMatch(d, matchId) {
      return isStringLen(matchId, 1, 128) &&
        d.keys().hasOnly(['roomId', 'processedAt', 'matchId']) &&
        d.keys().hasAll(['roomId', 'processedAt']) &&
        isStringLen(d.roomId, 6, 6) &&
        (!('matchId' in d) || d.matchId == matchId) &&
        d.processedAt == request.time;
    }

    function isValidAchievement(d, achievementId) {
      return isStringLen(achievementId, 1, 64) &&
        d.keys().hasOnly(['achievementId', 'progress', 'verified', 'unlockedAt']) &&
        d.keys().hasAll(['achievementId', 'progress', 'verified']) &&
        d.achievementId == achievementId &&
        d.progress is int && d.progress >= 0 && d.progress <= 100 &&
        d.verified is bool &&
        isOptionalNullableTimestamp(d, 'unlockedAt');
    }

    function isValidTrophy(d, trophyId) {
      return isStringLen(trophyId, 1, 128) &&
        d.keys().hasOnly(['trophyId', 'matchId', 'roomId', 'title', 'awardedAt']) &&
        d.keys().hasAll(['trophyId', 'matchId', 'roomId', 'title', 'awardedAt']) &&
        d.trophyId == trophyId &&
        isStringLen(d.matchId, 1, 128) &&
        isStringLen(d.roomId, 6, 6) &&
        isStringLen(d.title, 1, 80) &&
        d.awardedAt == request.time;
    }

    function isValidFriendCode(d, code) {
      return isStringLen(code, 6, 12) &&
        d.keys().hasOnly(['uid', 'createdAt']) &&
        d.keys().hasAll(['uid', 'createdAt']) &&
        d.uid == request.auth.uid &&
        d.createdAt == request.time;
    }

    function isValidFriendRequest(d) {
      return d.keys().hasOnly([
          'senderUid', 'senderName', 'senderAvatar',
          'receiverUid', 'receiverName', 'receiverAvatar',
          'status', 'createdAt', 'expiresAt'
        ]) &&
        d.keys().hasAll([
          'senderUid', 'senderName', 'receiverUid', 'status', 'createdAt'
        ]) &&
        isStringLen(d.senderUid, 1, 128) &&
        isStringLen(d.senderName, 1, 20) &&
        isOptionalNullableString(d, 'senderAvatar', 0, 32) &&
        isStringLen(d.receiverUid, 1, 128) &&
        d.receiverUid != d.senderUid &&
        isOptionalNullableString(d, 'receiverName', 0, 20) &&
        isOptionalNullableString(d, 'receiverAvatar', 0, 32) &&
        d.status in ['pending', 'accepted', 'declined', 'cancelled'] &&
        d.createdAt is timestamp &&
        isOptionalNullableTimestamp(d, 'expiresAt');
    }

    function isValidFriendChallenge(d) {
      return d.keys().hasOnly([
          'senderUid', 'senderName', 'senderAvatar', 'senderEmoji',
          'receiverUid', 'receiverName',
          'mode', 'boardSize', 'bestOf', 'roomId',
          'status', 'createdAt', 'expiresAt'
        ]) &&
        d.keys().hasAll([
          'senderUid', 'senderName', 'receiverUid',
          'mode', 'boardSize', 'bestOf', 'status', 'createdAt'
        ]) &&
        isStringLen(d.senderUid, 1, 128) &&
        isStringLen(d.senderName, 1, 20) &&
        isOptionalNullableString(d, 'senderAvatar', 0, 32) &&
        isOptionalNullableString(d, 'senderEmoji', 0, 16) &&
        isStringLen(d.receiverUid, 1, 128) &&
        d.receiverUid != d.senderUid &&
        isOptionalNullableString(d, 'receiverName', 0, 20) &&
        d.mode in ['classic', 'blitz'] &&
        d.boardSize is int && d.boardSize in [3, 4, 5, 6] &&
        d.bestOf is int && d.bestOf in [3, 5] &&
        isOptionalNullableString(d, 'roomId', 0, 6) &&
        d.status in ['pending', 'accepted', 'declined', 'cancelled'] &&
        d.createdAt is timestamp &&
        isOptionalNullableTimestamp(d, 'expiresAt');
    }

    function isValidReport(d) {
      return d.keys().hasOnly(['reporterUid', 'reportedUid', 'reason', 'createdAt']) &&
        d.keys().hasAll(['reporterUid', 'reportedUid', 'reason', 'createdAt']) &&
        d.reporterUid == request.auth.uid &&
        isStringLen(d.reportedUid, 1, 128) &&
        d.reportedUid != request.auth.uid &&
        isStringLen(d.reason, 1, 300) &&
        d.createdAt == request.time;
    }

    function isValidPlayerStats(d) {
      return d.keys().hasOnly([
          'gamesPlayed', 'wins', 'losses', 'draws', 'tournamentsWon',
          'currentStreak', 'bestStreak', 'blitzWins', 'megaWins',
          'trophyCount', 'updatedAt'
        ]) &&
        d.keys().size() >= 1 &&
        isOptionalNonNegInt(d, 'gamesPlayed', 1000000) &&
        isOptionalNonNegInt(d, 'wins', 1000000) &&
        isOptionalNonNegInt(d, 'losses', 1000000) &&
        isOptionalNonNegInt(d, 'draws', 1000000) &&
        isOptionalNonNegInt(d, 'tournamentsWon', 1000000) &&
        isOptionalNonNegInt(d, 'currentStreak', 1000000) &&
        isOptionalNonNegInt(d, 'bestStreak', 1000000) &&
        isOptionalNonNegInt(d, 'blitzWins', 1000000) &&
        isOptionalNonNegInt(d, 'megaWins', 1000000) &&
        isOptionalNonNegInt(d, 'trophyCount', 1000000) &&
        d.get('bestStreak', 0) >= d.get('currentStreak', 0) &&
        isOptionalNullableTimestamp(d, 'updatedAt');
    }

    function isValidPlayerStatsCreate(d) {
      return d.get('gamesPlayed', 0) <= 1 &&
        d.get('wins', 0) <= 1 &&
        d.get('losses', 0) <= 1 &&
        d.get('draws', 0) <= 1 &&
        d.get('tournamentsWon', 0) <= 1 &&
        d.get('currentStreak', 0) <= 1 &&
        d.get('bestStreak', 0) <= 1 &&
        d.get('blitzWins', 0) <= 1 &&
        d.get('megaWins', 0) <= 1 &&
        d.get('trophyCount', 0) <= 1;
    }

    function isValidPlayerStatsUpdate(next, prev) {
      return isBoundedDelta(next.get('gamesPlayed', 0), prev.get('gamesPlayed', 0), 0, 5) &&
        isBoundedDelta(next.get('wins', 0), prev.get('wins', 0), 0, 5) &&
        isBoundedDelta(next.get('losses', 0), prev.get('losses', 0), 0, 5) &&
        isBoundedDelta(next.get('draws', 0), prev.get('draws', 0), 0, 5) &&
        isBoundedDelta(next.get('tournamentsWon', 0), prev.get('tournamentsWon', 0), 0, 1) &&
        isBoundedDelta(next.get('blitzWins', 0), prev.get('blitzWins', 0), 0, 5) &&
        isBoundedDelta(next.get('megaWins', 0), prev.get('megaWins', 0), 0, 5) &&
        isBoundedDelta(next.get('trophyCount', 0), prev.get('trophyCount', 0), 0, 1) &&
        isBoundedDelta(next.get('bestStreak', 0), prev.get('bestStreak', 0), 0, 5) &&
        (next.get('currentStreak', 0) == 0 ||
          isBoundedDelta(next.get('currentStreak', 0), prev.get('currentStreak', 0), 0, 5));
    }

    function isValidMatch(d, matchId) {
      return isStringLen(matchId, 1, 128) &&
        d.keys().hasOnly([
          'roomId', 'players', 'playerNames', 'gameMode', 'boardSize',
          'hostWins', 'guestWins', 'draws', 'finalWinnerUid', 'finalStatus',
          'completedAt', 'processedAt'
        ]) &&
        d.keys().hasAll([
          'roomId', 'players', 'gameMode', 'boardSize',
          'hostWins', 'guestWins', 'draws', 'finalWinnerUid', 'finalStatus',
          'completedAt'
        ]) &&
        isStringLen(d.roomId, 6, 6) &&
        isValidUidPair(d.players) &&
        (!('playerNames' in d) || d.playerNames == null || (d.playerNames is map && d.playerNames.size() <= 4)) &&
        d.gameMode in ['classic', 'blitz'] &&
        d.boardSize is int && d.boardSize in [3, 4, 5, 6] &&
        isNonNegInt(d.hostWins, 10) &&
        isNonNegInt(d.guestWins, 10) &&
        isNonNegInt(d.draws, 200) &&
        isStringLen(d.finalWinnerUid, 0, 128) &&
        d.finalStatus in ['won', 'draw'] &&
        d.completedAt is timestamp &&
        isOptionalNullableTimestamp(d, 'processedAt');
    }

    function isValidRivalry(d, rivalryId) {
      return isStringLen(rivalryId, 3, 260) &&
        d.keys().hasOnly([
          'playerUids', 'winsByPlayer', 'draws', 'totalMatches',
          'currentStreakOwner', 'currentStreak', 'bestStreak', 'lastMatchAt'
        ]) &&
        d.keys().hasAll(['playerUids', 'totalMatches']) &&
        isValidUidPair(d.playerUids) &&
        (!('winsByPlayer' in d) || (
          d.winsByPlayer is map &&
          d.winsByPlayer.size() <= 2 &&
          d.winsByPlayer.keys().hasOnly(d.playerUids)
        )) &&
        isOptionalNonNegInt(d, 'draws', 1000000) &&
        isNonNegInt(d.totalMatches, 1000000) &&
        isOptionalNullableString(d, 'currentStreakOwner', 0, 128) &&
        isOptionalNonNegInt(d, 'currentStreak', 1000000) &&
        isOptionalNonNegInt(d, 'bestStreak', 1000000) &&
        d.get('bestStreak', 0) >= d.get('currentStreak', 0) &&
        isOptionalNullableTimestamp(d, 'lastMatchAt');
    }

    function isValidLeaderboardEntry(d) {
      return d.keys().hasOnly([
          'publicNickname', 'avatarId', 'photoBase64',
          'wins', 'tournamentsWon', 'bestStreak', 'blitzWins',
          'optIn', 'allowFriendRequests', 'updatedAt'
        ]) &&
        d.keys().hasAll(['publicNickname', 'avatarId', 'optIn']) &&
        isStringLen(d.publicNickname, 1, 20) &&
        isStringLen(d.avatarId, 1, 32) &&
        isOptionalNullableString(d, 'photoBase64', 0, 140000) &&
        isOptionalNonNegInt(d, 'wins', 1000000) &&
        isOptionalNonNegInt(d, 'tournamentsWon', 1000000) &&
        isOptionalNonNegInt(d, 'bestStreak', 1000000) &&
        isOptionalNonNegInt(d, 'blitzWins', 1000000) &&
        d.optIn is bool &&
        isOptionalNullableBool(d, 'allowFriendRequests') &&
        isOptionalNullableTimestamp(d, 'updatedAt');
    }

    function isValidChat(d, chatId) {
      return isStringLen(chatId, 3, 260) &&
        d.keys().hasOnly([
          'participants', 'lastMessage', 'lastSenderUid', 'lastSenderName',
          'lastMessageAt', 'unreadBy', 'unreadCounts', 'clearedAtBy', 'updatedAt'
        ]) &&
        d.keys().hasAll(['participants']) &&
        isValidUidPair(d.participants) &&
        isOptionalNullableString(d, 'lastMessage', 0, 500) &&
        isOptionalNullableString(d, 'lastSenderUid', 0, 128) &&
        (!('lastSenderUid' in d) || d.lastSenderUid == null || d.lastSenderUid == '' ||
          d.lastSenderUid in d.participants) &&
        isOptionalNullableString(d, 'lastSenderName', 0, 20) &&
        isOptionalNullableTimestamp(d, 'lastMessageAt') &&
        isValidUnreadBy(d) &&
        isValidUnreadCounts(d) &&
        (!('clearedAtBy' in d) || d.clearedAtBy == null || (d.clearedAtBy is map && d.clearedAtBy.size() <= 2)) &&
        isOptionalNullableTimestamp(d, 'updatedAt');
    }

    function isValidDirectMessage(d) {
      return d.keys().hasOnly(['senderUid', 'senderName', 'text', 'imageBase64', 'msgType', 'deletedFor', 'createdAt']) &&
        d.keys().hasAll(['senderUid', 'createdAt']) &&
        isStringLen(d.senderUid, 1, 128) &&
        isOptionalNullableString(d, 'senderName', 0, 20) &&
        isOptionalNullableString(d, 'text', 0, 500) &&
        isOptionalNullableString(d, 'imageBase64', 0, 320000) &&
        (!('msgType' in d) || d.msgType == null || d.msgType in ['text', 'image', 'call']) &&
        (!('deletedFor' in d) || d.deletedFor == null || isValidUidListMax2(d.deletedFor)) &&
        (
          ('text' in d && d.text is string && d.text.size() > 0) ||
          ('imageBase64' in d && d.imageBase64 is string && d.imageBase64.size() > 0)
        ) &&
        d.createdAt is timestamp;
    }

    function isValidCall(d) {
      return d.keys().hasOnly([
          'callerUid', 'calleeUid', 'callerName', 'callerAvatar', 'calleeName',
          'roomId', 'status', 'offer', 'answer', 'createdAt', 'updatedAt'
        ]) &&
        d.keys().hasAll(['callerUid', 'calleeUid', 'callerName', 'status', 'createdAt']) &&
        isStringLen(d.callerUid, 1, 128) &&
        isStringLen(d.calleeUid, 1, 128) &&
        d.calleeUid != d.callerUid &&
        isStringLen(d.callerName, 1, 20) &&
        isOptionalNullableString(d, 'callerAvatar', 0, 32) &&
        isOptionalNullableString(d, 'calleeName', 0, 20) &&
        isOptionalNullableString(d, 'roomId', 0, 6) &&
        d.status in ['ringing', 'active', 'ended', 'declined', 'missed'] &&
        isOptionalNullableSdpMap(d, 'offer') &&
        isOptionalNullableSdpMap(d, 'answer') &&
        d.createdAt is timestamp &&
        isOptionalNullableTimestamp(d, 'updatedAt');
    }

    function isValidCallStatusTransition(prevStatus, nextStatus) {
      return (prevStatus == 'ringing' && nextStatus in ['ringing', 'active', 'ended', 'declined', 'missed']) ||
        (prevStatus == 'active' && nextStatus in ['active', 'ended']) ||
        (prevStatus == nextStatus && prevStatus in ['ended', 'declined', 'missed']);
    }

    function isValidIceCandidate(d) {
      return d.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex', 'createdAt']) &&
        d.keys().hasAll(['candidate']) &&
        isStringLen(d.candidate, 0, 2048) &&
        isOptionalNullableString(d, 'sdpMid', 0, 64) &&
        (!('sdpMLineIndex' in d) || d.sdpMLineIndex == null || isNonNegInt(d.sdpMLineIndex, 64)) &&
        isOptionalNullableTimestamp(d, 'createdAt');
    }

    function isValidAudioChunk(d) {
      return d.keys().hasOnly(['senderUid', 'audioBase64', 'durationMs', 'createdAt']) &&
        d.keys().hasAll(['senderUid', 'audioBase64', 'durationMs', 'createdAt']) &&
        d.senderUid == request.auth.uid &&
        isStringLen(d.audioBase64, 1, 350000) &&
        isNonNegInt(d.durationMs, 60000) &&
        d.createdAt == request.time;
    }

    function isValidGroup(d) {
      return d.keys().hasOnly([
          'name', 'creatorUid', 'hostFriendCode', 'maxMembers',
          'memberUids', 'memberNames', 'memberAvatars',
          'tournamentStatus', 'championUid', 'championName', 'runnerUpUid', 'runnerUpName', 'cupName',
          'fixtures', 'activeMatch', 'winsByUid', 'lossesByUid', 'drawsByUid', 'cupsByUid',
          'lastMessage', 'lastSenderUid', 'lastSenderName', 'lastMessageAt',
          'clearedAtBy', 'createdAt', 'updatedAt'
        ]) &&
        d.keys().hasAll([
          'name', 'creatorUid', 'memberUids', 'memberNames', 'memberAvatars',
          'tournamentStatus'
        ]) &&
        isStringLen(d.name, 1, 24) &&
        isStringLen(d.creatorUid, 1, 128) &&
        isOptionalNullableString(d, 'hostFriendCode', 0, 12) &&
        (!('maxMembers' in d) || d.maxMembers == null || (d.maxMembers is int && d.maxMembers >= 2 && d.maxMembers <= 5)) &&
        isValidGroupMemberUids(d.memberUids) &&
        d.memberUids.size() <= d.get('maxMembers', 5) &&
        d.memberNames is map && d.memberNames.size() <= 5 &&
        d.memberAvatars is map && d.memberAvatars.size() <= 5 &&
        d.tournamentStatus in ['active', 'final_ready', 'completed'] &&
        isOptionalNullableString(d, 'championUid', 0, 128) &&
        isOptionalNullableString(d, 'championName', 0, 20) &&
        isOptionalNullableString(d, 'runnerUpUid', 0, 128) &&
        isOptionalNullableString(d, 'runnerUpName', 0, 20) &&
        isOptionalNullableString(d, 'cupName', 0, 80) &&
        (!('fixtures' in d) || d.fixtures == null || (d.fixtures is list && d.fixtures.size() <= 15)) &&
        isOptionalNullableBoundedMap(d, 'activeMatch', 15) &&
        isOptionalNullableBoundedMap(d, 'winsByUid', 5) &&
        isOptionalNullableBoundedMap(d, 'lossesByUid', 5) &&
        isOptionalNullableBoundedMap(d, 'drawsByUid', 5) &&
        isOptionalNullableBoundedMap(d, 'cupsByUid', 5) &&
        isOptionalNullableString(d, 'lastMessage', 0, 500) &&
        isOptionalNullableString(d, 'lastSenderUid', 0, 128) &&
        isOptionalNullableString(d, 'lastSenderName', 0, 20) &&
        isOptionalNullableTimestamp(d, 'lastMessageAt') &&
        isOptionalNullableBoundedMap(d, 'clearedAtBy', 5) &&
        isOptionalNullableTimestamp(d, 'createdAt') &&
        isOptionalNullableTimestamp(d, 'updatedAt');
    }

    function isValidGroupMessage(d) {
      return d.keys().hasOnly(['senderUid', 'senderName', 'text', 'imageBase64', 'msgType', 'deletedFor', 'createdAt']) &&
        d.keys().hasAll(['senderUid', 'createdAt']) &&
        isStringLen(d.senderUid, 1, 128) &&
        isOptionalNullableString(d, 'senderName', 0, 20) &&
        isOptionalNullableString(d, 'text', 0, 500) &&
        isOptionalNullableString(d, 'imageBase64', 0, 320000) &&
        (!('msgType' in d) || d.msgType == null || d.msgType in ['text', 'image', 'call']) &&
        (!('deletedFor' in d) || d.deletedFor == null || isValidUidListMax5(d.deletedFor)) &&
        (
          ('text' in d && d.text is string && d.text.size() > 0) ||
          ('imageBase64' in d && d.imageBase64 is string && d.imageBase64.size() > 0)
        ) &&
        d.createdAt is timestamp;
    }

    // ===============================================================
    // 1. Game Rooms, Chat Messages & Reactions
    // ===============================================================

    match /rooms/{roomId} {
      // Needed to look up a room by its unguessable 6-character code; listing is forbidden.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn() &&
        isValidRoom(request.resource.data) &&
        request.resource.data.hostId == request.auth.uid &&
        request.resource.data.guestId == '' &&
        request.resource.data.status == 'lobby' &&
        request.resource.data.round == 1 &&
        request.resource.data.roundDone == false &&
        request.resource.data.hostWins == 0 &&
        request.resource.data.guestWins == 0 &&
        request.resource.data.draws == 0 &&
        (!('champion' in request.resource.data) || request.resource.data.champion == '') &&
        request.resource.data.createdAt == request.time;

      allow update: if signedIn() &&
        isValidRoom(request.resource.data) && (
          // Path A: Guest joins an open lobby room.
          (
            resource.data.guestId == '' &&
            resource.data.status == 'lobby' &&
            request.auth.uid != resource.data.hostId &&
            request.resource.data.guestId == request.auth.uid &&
            request.resource.data.status == 'playing' &&
            isStringLen(request.resource.data.guestName, 1, 20) &&
            isStringLen(request.resource.data.guestEmoji, 1, 16) &&
            request.resource.data.guestEmoji != resource.data.hostEmoji &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'guestId', 'guestName', 'guestEmoji', 'guestAvatar',
              'status', 'turnStartedAt', 'turnDeadlineAt', 'updatedAt'
            ])
          )
          ||
          // Path B: Active gameplay, challenge wheel lock-in, or player leave.
          (
            isRoomMember(resource.data) &&
            areImmutableFieldsUnchanged([
              'hostId', 'guestId', 'hostName', 'guestName',
              'hostAvatar', 'guestAvatar', 'createdAt', 'expiresAt'
            ]) &&
            // Each player may only toggle their own leave flag.
            (request.resource.data.get('hostLeft', false) == resource.data.get('hostLeft', false) ||
              request.auth.uid == resource.data.hostId) &&
            (request.resource.data.get('guestLeft', false) == resource.data.get('guestLeft', false) ||
              request.auth.uid == resource.data.guestId) &&
            (
              // Lobby host leave / cancel before a guest joins.
              (
                resource.data.guestId == '' &&
                request.auth.uid == resource.data.hostId &&
                request.resource.data.status in ['lobby', 'abandoned', 'finished'] &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'hostLeft', 'status', 'updatedAt'
                ])
              )
              ||
              // Post-join gameplay, wheel lock-in, rematch, or leave.
              (
                resource.data.guestId != '' &&
                canModifyWheelConfig(resource.data, request.resource.data) &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'board', 'turn', 'round', 'roundDone', 'lastResult',
                  'hostWins', 'guestWins', 'draws', 'champion', 'status',
                  'turnStartedAt', 'turnDeadlineAt', 'timeoutWinner',
                  'wheelProposal', 'wheelResult',
                  'gameMode', 'size', 'bestOf', 'hostEmoji', 'guestEmoji',
                  'hostLeft', 'guestLeft', 'updatedAt'
                ])
              )
            )
          )
        );

      allow delete: if false;

      // 2. Room Chat Messages (v1 text-only compatible + v3 image sharing)
      match /messages/{messageId} {
        allow read: if roomExistsAndMember(roomId);
        allow create: if roomExistsAndMember(roomId) &&
          isValidChatMessage(request.resource.data);
        allow update: if false;
        allow delete: if roomExistsAndMember(roomId);
      }

      // 3. Ephemeral Room Reactions & Taunts
      match /reactions/{reactionId} {
        allow read: if roomExistsAndMember(roomId);
        allow create: if roomExistsAndMember(roomId) &&
          isValidReaction(request.resource.data);
        allow update, delete: if false;
      }
    }

    // ===============================================================
    // 4-7. Users, Private Settings, Friends, Blocked, Processed Matches,
    //      Achievements & Trophies
    // ===============================================================

    match /users/{uid} {
      // Non-PII game profile only; private data lives in users/{uid}/private/{docId}.
      allow get: if signedIn() && (
        request.auth.uid == uid ||
        (
          resource != null && ('profileVisibility' in resource.data) && resource.data.profileVisibility == 'private'
            ? false
            : (
              resource != null && ('profileVisibility' in resource.data) && resource.data.profileVisibility == 'friends'
                ? exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid))
                : (
                  (resource != null && resource.data.publicProfileEnabled == true) ||
                  exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid))
                )
            )
        )
      );
      allow list: if false;

      allow create: if isOwner(uid) &&
        isValidUserProfile(request.resource.data) &&
        (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time);

      allow update: if isOwner(uid) &&
        isValidUserProfile(request.resource.data) &&
        // createdAt cannot be altered or removed once set.
        (!('createdAt' in resource.data) || resource.data.createdAt == null ||
          ('createdAt' in request.resource.data && request.resource.data.createdAt == resource.data.createdAt)) &&
        // friendCode is immutable once assigned.
        (!('friendCode' in resource.data) || resource.data.friendCode == null || resource.data.friendCode == '' ||
          ('friendCode' in request.resource.data && request.resource.data.friendCode == resource.data.friendCode));

      allow delete: if isOwner(uid);

      // 5. Private owner-only preferences & hidden rivals
      match /private/{docId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) &&
          isValidPrivateDoc(request.resource.data, docId) &&
          (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time);
        allow update: if isOwner(uid) &&
          isValidPrivateDoc(request.resource.data, docId) &&
          (!('createdAt' in resource.data) ||
            ('createdAt' in request.resource.data && request.resource.data.createdAt == resource.data.createdAt));
        allow delete: if isOwner(uid);
      }

      // 6. Friends subcollection
      match /friends/{friendUid} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid) || (signedIn() && request.auth.uid == friendUid);

        allow create: if signedIn() &&
          isValidFriendEntry(request.resource.data, uid, friendUid) && (
            isOwner(uid) ||
            (
              request.auth.uid == friendUid &&
              request.resource.data.friendUid == request.auth.uid &&
              request.resource.data.status == 'accepted' &&
              !isBlockedBy(uid, request.auth.uid)
            )
          );

        allow update: if signedIn() &&
          isValidFriendEntry(request.resource.data, uid, friendUid) &&
          areImmutableFieldsUnchanged(['friendUid', 'since']) && (
            isOwner(uid) ||
            (
              request.auth.uid == friendUid &&
              request.resource.data.friendUid == request.auth.uid &&
              request.resource.data.status == 'accepted' &&
              !isBlockedBy(uid, request.auth.uid)
            )
          );
      }

      // 7. Blocked users subcollection (owner-only)
      match /blocked/{blockedUid} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) &&
          isValidBlockedEntry(request.resource.data, uid, blockedUid) &&
          (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time);
        allow update: if isOwner(uid) &&
          isValidBlockedEntry(request.resource.data, uid, blockedUid) &&
          (!('createdAt' in resource.data) ||
            ('createdAt' in request.resource.data && request.resource.data.createdAt == resource.data.createdAt));
      }

      // 7b. Processed Matches Ledger (Owner-only, immutable idempotency guard)
      match /processedMatches/{matchId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) &&
          isValidProcessedMatch(request.resource.data, matchId);
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      // 12a. Achievements (Spark-compatible owner updates + public profile reads)
      match /achievements/{achievementId} {
        allow read: if isOwner(uid) || (signedIn() && isPublicProfile(uid));
        allow create: if isOwner(uid) &&
          isValidAchievement(request.resource.data, achievementId);
        allow update: if isOwner(uid) &&
          isValidAchievement(request.resource.data, achievementId) &&
          areImmutableFieldsUnchanged(['achievementId']);
        allow delete: if isOwner(uid);
      }

      // 12b. Trophies (Immutable, verified against finished room champion)
      match /trophies/{trophyId} {
        allow read: if isOwner(uid) || (signedIn() && isPublicProfile(uid));
        allow create: if isOwner(uid) &&
          isValidTrophy(request.resource.data, trophyId) &&
          isFinishedRoomChampion(request.resource.data.roomId, uid);
        allow update: if false;
        allow delete: if isOwner(uid);
      }
    }

    // ===============================================================
    // 8. Friend Codes Lookup
    // ===============================================================

    match /friendCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() &&
        isValidFriendCode(request.resource.data, code);
      allow update: if false;
      allow delete: if isDocOwner();
    }

    // ===============================================================
    // 9. Friend Requests
    // ===============================================================

    match /friendRequests/{requestId} {
      allow read: if signedIn() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid
      );

      allow create: if signedIn() &&
        isValidFriendRequest(request.resource.data) &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.receiverUid != request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time &&
        !isBlockedBy(request.resource.data.receiverUid, request.auth.uid);

      allow update: if signedIn() &&
        isValidFriendRequest(request.resource.data) &&
        resource.data.status == 'pending' &&
        areImmutableFieldsUnchanged([
          'senderUid', 'senderName', 'senderAvatar',
          'receiverUid', 'createdAt', 'expiresAt'
        ]) && (
          (
            resource.data.receiverUid == request.auth.uid &&
            request.resource.data.status in ['accepted', 'declined'] &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'receiverName', 'receiverAvatar'
            ])
          )
          ||
          (
            resource.data.senderUid == request.auth.uid &&
            request.resource.data.status == 'cancelled' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          )
        );

      allow delete: if signedIn() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid
      );
    }

    // ===============================================================
    // 10. Direct Friend Challenges
    // ===============================================================

    match /friendChallenges/{challengeId} {
      allow read: if signedIn() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid
      );

      allow create: if signedIn() &&
        isValidFriendChallenge(request.resource.data) &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.receiverUid != request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time &&
        !isBlockedBy(request.resource.data.receiverUid, request.auth.uid);

      allow update: if signedIn() &&
        isValidFriendChallenge(request.resource.data) &&
        areImmutableFieldsUnchanged([
          'senderUid', 'senderName', 'senderAvatar', 'senderEmoji',
          'receiverUid', 'receiverName',
          'mode', 'boardSize', 'bestOf', 'createdAt', 'expiresAt'
        ]) && (
          (
            resource.data.status == 'pending' &&
            resource.data.receiverUid == request.auth.uid &&
            request.resource.data.status == 'accepted' &&
            request.resource.data.roomId is string &&
            request.resource.data.roomId.size() == 6 &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'roomId'])
          )
          ||
          (
            resource.data.status == 'pending' &&
            resource.data.receiverUid == request.auth.uid &&
            request.resource.data.status == 'declined' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          )
          ||
          (
            resource.data.status in ['pending', 'accepted'] &&
            resource.data.senderUid == request.auth.uid &&
            request.resource.data.status == 'cancelled' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          )
        );

      allow delete: if signedIn() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid
      );
    }

    // ===============================================================
    // 11. Abuse Reports (Write-Only by Authenticated Reporter)
    // ===============================================================

    match /reports/{reportId} {
      allow create: if signedIn() &&
        isValidReport(request.resource.data);
      allow read, update, delete: if false;
    }

    // ===============================================================
    // 12. Verified Match Finalization, Stats, Rivalries & Leaderboards
    //     (Spark-Compatible Client Writes with Bounded Deltas & Room Proofs)
    // ===============================================================

    match /stats/{uid} {
      allow get: if isOwner(uid) || (signedIn() && isPublicProfile(uid));
      allow list: if false;

      allow create: if isOwner(uid) &&
        isValidPlayerStats(request.resource.data) &&
        isValidPlayerStatsCreate(request.resource.data);

      allow update: if isOwner(uid) &&
        isValidPlayerStats(request.resource.data) &&
        isValidPlayerStatsUpdate(request.resource.data, resource.data);

      allow delete: if isOwner(uid);
    }

    match /matches/{matchId} {
      allow get: if signedIn() && (
        resource == null ||
        request.auth.uid in resource.data.players
      );
      allow list: if signedIn() && (request.auth.uid in resource.data.players);

      allow create: if signedIn() &&
        isValidMatch(request.resource.data, matchId) &&
        request.auth.uid in request.resource.data.players &&
        isFinishedRoomMemberMatch(request.resource.data);

      allow update, delete: if false;
    }

    match /rivalries/{rivalryId} {
      allow get: if signedIn() && (
        (resource == null && rivalryId.matches('.*' + request.auth.uid + '.*')) ||
        (resource != null && request.auth.uid in resource.data.playerUids)
      );
      allow list: if signedIn() && (request.auth.uid in resource.data.playerUids);

      allow create: if signedIn() &&
        isValidRivalry(request.resource.data, rivalryId) &&
        request.auth.uid in request.resource.data.playerUids &&
        request.resource.data.totalMatches <= 1 &&
        request.resource.data.get('draws', 0) <= 1 &&
        request.resource.data.get('currentStreak', 0) <= 1 &&
        request.resource.data.get('bestStreak', 0) <= 1;

      allow update: if signedIn() &&
        request.auth.uid in resource.data.playerUids &&
        isValidRivalry(request.resource.data, rivalryId) &&
        request.resource.data.playerUids == resource.data.playerUids &&
        isBoundedDelta(request.resource.data.totalMatches, resource.data.get('totalMatches', 0), 0, 1) &&
        isBoundedDelta(request.resource.data.get('draws', 0), resource.data.get('draws', 0), 0, 1) &&
        isBoundedDelta(request.resource.data.get('bestStreak', 0), resource.data.get('bestStreak', 0), 0, 1) &&
        (request.resource.data.get('currentStreak', 0) <= 1 ||
          isBoundedDelta(request.resource.data.get('currentStreak', 0), resource.data.get('currentStreak', 0), 0, 1));

      allow delete: if false;
    }

    match /leaderboardEntries/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid || resource.data.optIn == true
      );

      allow create: if isOwner(uid) &&
        isValidLeaderboardEntry(request.resource.data) &&
        isValidLeaderboardCreateCounts(uid, request.resource.data);

      allow update: if isOwner(uid) &&
        isValidLeaderboardEntry(request.resource.data) && (
          (
            isBoundedDelta(request.resource.data.get('wins', 0), resource.data.get('wins', 0), 0, 1) &&
            isBoundedDelta(request.resource.data.get('tournamentsWon', 0), resource.data.get('tournamentsWon', 0), 0, 1) &&
            isBoundedDelta(request.resource.data.get('blitzWins', 0), resource.data.get('blitzWins', 0), 0, 1) &&
            isBoundedDelta(request.resource.data.get('bestStreak', 0), resource.data.get('bestStreak', 0), 0, 1)
          ) || (
            exists(/databases/$(database)/documents/stats/$(uid)) &&
            isLeaderboardBoundedByStats(request.resource.data, get(/databases/$(database)/documents/stats/$(uid)).data)
          )
        );

      allow delete: if isOwner(uid);
    }

    // ===============================================================
    // 13. Direct 1-on-1 Friend Chat
    // ===============================================================

    match /chats/{chatId} {
      allow get: if signedIn() && (
        (resource == null && chatId.matches('.*' + request.auth.uid + '.*')) ||
        (resource != null && request.auth.uid in resource.data.participants)
      );
      allow list: if signedIn() && (request.auth.uid in resource.data.participants);

      allow create: if signedIn() &&
        isValidChat(request.resource.data, chatId) &&
        request.auth.uid in request.resource.data.participants &&
        !isBlockedBy(otherParticipant(request.resource.data.participants), request.auth.uid);

      allow update: if signedIn() &&
        request.auth.uid in resource.data.participants &&
        isValidChat(request.resource.data, chatId) &&
        request.resource.data.participants == resource.data.participants &&
        !isBlockedBy(otherParticipant(resource.data.participants), request.auth.uid);

      allow delete: if signedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if chatExistsAndParticipant(chatId);
        allow create: if chatExistsAndParticipant(chatId) &&
          isValidDirectMessage(request.resource.data) &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.createdAt == request.time;
        allow update: if chatExistsAndParticipant(chatId) &&
          isValidDirectMessage(request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor']);
        allow delete: if chatExistsAndParticipant(chatId);
      }
    }

    // ===============================================================
    // 14. WebRTC Peer-to-Peer Voice Calls
    // ===============================================================

    match /calls/{callId} {
      allow read: if signedIn() && (
        resource.data.callerUid == request.auth.uid ||
        resource.data.calleeUid == request.auth.uid
      );

      allow create: if signedIn() &&
        isValidCall(request.resource.data) &&
        request.resource.data.callerUid == request.auth.uid &&
        request.resource.data.calleeUid != request.auth.uid &&
        request.resource.data.status == 'ringing' &&
        !isBlockedBy(request.resource.data.calleeUid, request.auth.uid) &&
        request.resource.data.createdAt == request.time;

      allow update: if signedIn() &&
        isValidCall(request.resource.data) &&
        (resource.data.callerUid == request.auth.uid || resource.data.calleeUid == request.auth.uid) &&
        areImmutableFieldsUnchanged(['callerUid', 'calleeUid', 'createdAt']) &&
        isValidCallStatusTransition(resource.data.status, request.resource.data.status);

      allow delete: if signedIn() && (
        resource.data.callerUid == request.auth.uid ||
        resource.data.calleeUid == request.auth.uid
      );

      match /offerCandidates/{candidateId} {
        allow read: if callExistsAndParticipant(callId);
        allow create: if callExistsAndParticipant(callId) &&
          isValidIceCandidate(request.resource.data);
        allow update, delete: if false;
      }

      match /answerCandidates/{candidateId} {
        allow read: if callExistsAndParticipant(callId);
        allow create: if callExistsAndParticipant(callId) &&
          isValidIceCandidate(request.resource.data);
        allow update, delete: if false;
      }

      match /audioChunks/{chunkId} {
        allow read: if callExistsAndParticipant(callId);
        allow create: if callExistsAndParticipant(callId) &&
          isValidAudioChunk(request.resource.data);
        allow update, delete: if false;
      }
    }

    // ===============================================================
    // 15. Read-Only Runtime Config (Dynamic TURN / RTC ICE Servers)
    // ===============================================================

    match /config/{docId} {
      allow get: if signedIn() && docId == 'rtc';
      allow list, write: if false;
    }

    // ===============================================================
    // 16. Friend Groups & Group Tournament Chat
    // ===============================================================

    match /groups/{groupId} {
      allow read: if signedIn();

      allow create: if signedIn() &&
        isValidGroup(request.resource.data) &&
        request.resource.data.creatorUid == request.auth.uid &&
        request.auth.uid in request.resource.data.memberUids;

      allow update: if signedIn()
        && isValidGroup(request.resource.data)
        && (
          request.auth.uid in resource.data.memberUids
          || request.auth.uid == resource.data.creatorUid
          || (
            request.auth.uid in request.resource.data.memberUids
            && request.resource.data.memberUids.size() <= resource.data.maxMembers
          )
          || (
            request.resource.data.creatorUid == request.auth.uid
            && request.auth.uid in request.resource.data.memberUids
          )
        );

      allow delete: if signedIn()
        && (
          request.auth.uid in resource.data.memberUids
          || request.auth.uid == resource.data.creatorUid
        );

      match /messages/{messageId} {
        allow read: if groupExistsAndMember(groupId);
        allow create: if groupExistsAndMember(groupId) &&
          isValidGroupMessage(request.resource.data) &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.createdAt == request.time;
        allow update: if groupExistsAndMember(groupId) &&
          isValidGroupMessage(request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor']);
        allow delete: if groupExistsAndMember(groupId);
      }
    }

    // ===============================================================
    // Default Deny Fallback
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
